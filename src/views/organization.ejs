<%- include('partials/header') %>

    <main class="page-container">
        <section class="page-heading">
            <p class="eyebrow">OUR PARTNER ORGANIZATIONS</p>
            <h1>
                <%= title %>
            </h1>
        </section>

        <section class="organization-card">
            <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">

            <div>
                <h2>
                    <%= organizationDetails.name %>
                </h2>
                <p>
                    <%= organizationDetails.description %>
                </p>
                <a href="mailto:<%= organizationDetails.contact_email %>">
                    <%= organizationDetails.contact_email %>
                </a>
            </div>
        </section>

        <section class="page-heading">
            <h2>Service Projects</h2>
            <p>Explore the service opportunities offered by this organization.</p>
        </section>

        <section class="project-grid" aria-label="Organization service projects">
            <% projects.forEach(project=> { %>
                <article class="project-card">
                    <h3>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h3>
                    <p>
                        <%= project.description %>
                    </p>
                    <p><strong>Location:</strong>
                        <%= project.location %>
                    </p>
                </article>
                <% }); %>
        </section>
    </main>

<%- include('partials/footer') %>