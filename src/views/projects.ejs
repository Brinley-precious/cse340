<%- include('partials/header') %>

    <main class="page-container">
        <section class="page-heading">
            <p class="eyebrow">GET INVOLVED</p>
            <h1>
                <%= title %>
            </h1>
            <p>Every contribution matters. Explore these service opportunities and find a way to get involved.</p>
        </section>

        <section class="project-grid" aria-label="Upcoming service projects">
            <% projects.forEach(project=> { %>
                <article class="project-card">
                    <span class="project-tag">
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </span>

                    <h2>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h2>

                    <p>
                        <%= new Date(project.date + 'T00:00:00' ).toLocaleDateString('en-GB', { day: 'numeric' ,
                            month: 'long' , year: 'numeric' }) %>
                    </p>

                    <p>
                        <%= project.description %>
                    </p>

                    <p>
                        <strong>Location:</strong>
                        <%= project.location %>
                    </p>
                </article>
                <% }); %>
        </section>
    </main>

    <%- include('partials/footer') %>