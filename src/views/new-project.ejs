<%- include('partials/header') %>

    <main class="page-container">
        <section class="page-heading">
            <p class="eyebrow">GET INVOLVED</p>
            <h1>
                <%= title %>
            </h1>
            <p>Share a new service opportunity with the community.</p>
        </section>

        <form class="form-card" action="/new-project" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" required minlength="3" maxlength="200" />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required maxlength="999"></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" required maxlength="199" />
            </div>

            <div class="form-group">
                <label for="date">Project Date</label>
                <input type="date" id="date" name="date" required />
            </div>

            <div class="form-group">
                <label for="organizationId">Associated Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <option value="" disabled selected>Select an organization</option>

                    <% organizations.forEach(organization=> { %>
                        <option value="<%= organization.organization_id %>">
                            <%= organization.name %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <button type="submit">Add Service Project</button>

        </form>
    </main>

<%- include('partials/footer') %>