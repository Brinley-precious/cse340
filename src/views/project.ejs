<%- include('partials/header') %>

    <main class="page-container">
        <section class="page-heading">
            <p class="eyebrow">SERVICE PROJECT DETAILS</p>
            <h1>
                <%= project.title %>
            </h1>
        </section>

        <section class="project-card">
            <p>
                <%= project.description %>
            </p>

            <p>
                <strong>Date:</strong>
                <%= new Date(project.date + 'T00:00:00' ).toLocaleDateString('en-GB', { day: 'numeric' , month: 'long' ,
                    year: 'numeric' }) %>
            </p>

            <p>
                <strong>Location:</strong>
                <%= project.location %>
            </p>

            <p>
                <strong>Partner Organization:</strong>
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
            </p>

            <div>
                <strong>Categories:</strong>

                <div class="category-tags">
                    <% categories.forEach(category=> { %>
                        <a class="project-tag" href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                        <% }); %>
                </div>
            </div>
        </section>
    </main>

<%- include('partials/footer') %>