<%- include('partials/header') %>

    <main class="page-container">
        <section class="page-heading">
            <p class="eyebrow">FIND YOUR CAUSE</p>
            <h1>
                <%= title %>
            </h1>
            <p>Explore different areas of service and discover causes you can support.</p>

            <a href="/new-category" class="button button-primary">
                Create New Category
            </a>
        </section>

        <section class="category-grid" aria-label="Service categories">

            <% const categoryPresentation={ 'Environment' : { icon: '🌱' ,
                description: 'Protecting the environment, improving shared spaces, and promoting sustainability.'
                }, 'Education' : { icon: '📚' ,
                description: 'Supporting learning, literacy, education, and the development of new skills.'
                }, 'Community Support' : { icon: '🤝' ,
                description: 'Bringing people together to respond to local needs and strengthen communities.'
                }, 'Health and Wellness' : { icon: '💚' ,
                description: 'Promoting healthy living, personal well-being, and access to health-related support.' } };
                %>

                <% categories.forEach(category=> { %>

                    <% const presentation=categoryPresentation[category.name] || { icon: '✨' ,
                        description: 'Explore service opportunities and discover ways to make a positive difference in this area.'
                        }; %>

                        <article class="category-card">

                            <span class="category-icon" aria-hidden="true">
                                <%= presentation.icon %>
                            </span>

                            <h2>
                                <a href="/category/<%= category.category_id %>">
                                    <%= category.name %>
                                </a>
                            </h2>

                            <p>
                                <%= presentation.description %>
                            </p>

                            <a href="/edit-category/<%= category.category_id %>">
                                Edit Category
                            </a>

                        </article>

                        <% }); %>

        </section>
    </main>

<%- include('partials/footer') %>