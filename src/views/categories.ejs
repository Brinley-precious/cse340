<%- include('partials/header') %>

    <main class="page-container">
        <section class="page-heading">
            <p class="eyebrow">FIND YOUR CAUSE</p>
            <h1>
                <%= title %>
            </h1>
            <p>Explore different areas of service and discover causes you can support.</p>
        </section>

        <section class="category-grid" aria-label="Service categories">

            <% categories.forEach(category=> { %>
                <article class="category-card">

                    <% if (category.name==='Environment' ) { %>
                        <span class="category-icon" aria-hidden="true">🌱</span>
                        <h2>
                            <a href="/category/<%= category.category_id %>">
                                <%= category.name %>
                            </a>
                        </h2>
                        <p>Protecting the environment, improving shared spaces, and promoting sustainability.</p>

                        <% } else if (category.name==='Education' ) { %>
                            <span class="category-icon" aria-hidden="true">📚</span>
                            <h2>
                                <a href="/category/<%= category.category_id %>">
                                    <%= category.name %>
                                </a>
                            </h2>
                            <p>Supporting learning, literacy, education, and the development of new skills.</p>

                            <% } else if (category.name==='Community Support' ) { %>
                                <span class="category-icon" aria-hidden="true">🤝</span>
                                <h2>
                                    <a href="/category/<%= category.category_id %>">
                                        <%= category.name %>
                                    </a>
                                </h2>
                                <p>Bringing people together to respond to local needs and strengthen communities.</p>

                                <% } else if (category.name==='Health and Wellness' ) { %>
                                    <span class="category-icon" aria-hidden="true">💚</span>
                                    <h2>
                                        <a href="/category/<%= category.category_id %>">
                                            <%= category.name %>
                                        </a>
                                    </h2>
                                    <p>Promoting healthy living, personal well-being, and access to health-related
                                        support.</p>
                                    <% } %>

                </article>
                <% }); %>

        </section>
    </main>

<%- include('partials/footer') %>