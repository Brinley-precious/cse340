<%- include('partials/header') %>

    <main class="page-container">

        <section class="page-heading">
            <p class="eyebrow">MANAGE CATEGORIES</p>
            <h1>
                <%= title %>
            </h1>
            <p>Update the name of this service category.</p>
        </section>

        <section class="form-card">

            <form action="/edit-category/<%= category.category_id %>" method="POST">

                <div class="form-group">
                    <label for="name">Category Name</label>

                    <input type="text" id="name" name="name" value="<%= category.name %>" required maxlength="100" />
                </div>

                <button type="submit">Update Category</button>

            </form>

        </section>

    </main>

<%- include('partials/footer') %>