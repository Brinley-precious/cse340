<%- include('partials/header') %>

    <main class="page-container">
        <section class="page-heading">
            <p class="eyebrow">MANAGE SERVICE PROJECT</p>
            <h1>
                <%= title %>
            </h1>
            <p>Update the details of this service opportunity.</p>
        </section>

        <form action="/edit-project/<%= project.project_id %>" method="POST">

            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" value="<%= project.title %>" required minlength="3"
                    maxlength="200" />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required
                    maxlength="999"><%= project.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" value="<%= project.location %>" required
                    maxlength="199" />
            </div>

            <div class="form-group">
                <label for="date">Project Date</label>
                <input type="date" id="date" name="date" value="<%= project.date %>" required />
            </div>

            <div class="form-group">
                <label for="organizationId">Associated Organization</label>
                <select id="organizationId" name="organizationId" required>

                    <% organizations.forEach(organization=> { %>
                        <option value="<%= organization.organization_id %>"
                            <%=Number(organization.organization_id)===Number(project.organization_id) ? 'selected' : ''
                            %>
                            >
                            <%= organization.name %>
                        </option>
                        <% }); %>

                </select>
            </div>

            <button type="submit">Update Service Project</button>

        </form>
    </main>

<%- include('partials/footer') %>