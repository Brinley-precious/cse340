<%- include('partials/header') %>

    <main class="page-container">
        <section class="page-heading">
            <p class="eyebrow">MANAGE SERVICE PROJECT</p>
            <h1>
                <%= title %>
            </h1>
            <p>Select the categories that best describe this service project.</p>
        </section>

        <section class="project-card">
            <h2>
                <%= projectDetails.title %>
            </h2>

            <form action="/assign-categories/<%= projectId %>" method="POST">
                <div class="form-group">
                    <% categories.forEach(category=> { %>
                        <div>
                            <input type="checkbox" id="category-<%= category.category_id %>" name="categoryIds"
                                value="<%= category.category_id %>" <%=assignedCategories.some(ac=>
                            Number(ac.category_id) === Number(category.category_id)) ? 'checked' : '' %>
                            >
                            <label for="category-<%= category.category_id %>">
                                <%= category.name %>
                            </label>
                        </div>
                        <% }); %>
                </div>

                <button type="submit">Update Categories</button>
            </form>
        </section>
    </main>

<%- include('partials/footer') %>