<%- include('partials/header') %>

    <main class="page-container">
        <section class="page-heading">
            <p class="eyebrow">WORKING TOGETHER</p>
            <h1>
                <%= title %>
            </h1>
            <p>Meet some of the organisations making a difference through service.</p>
        </section>

        <section class="organization-grid" aria-label="Partner organisations">

            <% organizations.forEach(organization=> { %>
                <article class="organization-card">
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">

                    <div>
                        <h2>
                            <a href="/organization/<%= organization.organization_id %>">
                                <%= organization.name %>
                            </a>
                        </h2>
                        <p>
                            <%= organization.description %>
                        </p>
                        <a href="mailto:<%= organization.contact_email %>">
                            <%= organization.contact_email %>
                        </a>
                    </div>
                </article>
                <% }); %>

        </section>
    </main>

<%- include('partials/footer') %>